<?xml version="1.0" encoding="utf-8" ?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" loadImage="GetImage" onLoad="OnRibbonLoad">
    <ribbon>
        <tabs>
            <tab id="tabNoteHighlight" label="NoteHighlight" keytip="H">
                <group id="groupLanguage" label="Language">
                  <!--
                    Generic pinned-language "slot" buttons. Content (label, image,
                    screentip, visibility) is resolved at runtime via get* callbacks
                    against LanguageSettings.Pinned[slotIndex], so pinned languages
                    render in the user's chosen order.

                    N = 14 slots. This count is COUPLED to the MaxPinned constant in
                    LanguageSettingsForm.cs - if one changes the other must change too.
                    The coupling is locked by the unit test
                    Ribbon_GroupLanguage_HasExactlyMaxPinnedSlotButtons.

                    Keytips are static and positional (slot 0 -> "1" .. slot 8 -> "9",
                    slot 9 -> "0", slots 10-13 -> "F", "G", "K", "N"). The four letters
                    for slots 10-13 were chosen demonstrably unused tab-wide: keytips
                    already claimed across tabNoteHighlight are H (tab), C S E J X V P B
                    A R D (groupLanguage language buttons), M (menuMoreLanguages) and L
                    (buttonLanguages in groupAdvanced); F, G, K, N collide with none of
                    these. The hidden groupLanguageCatalogue does not render and so does
                    not claim keytips.
                  -->
                  <button id="slotLang00" size="large" keytip="1" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang01" size="large" keytip="2" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang02" size="large" keytip="3" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang03" size="large" keytip="4" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang04" size="large" keytip="5" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang05" size="large" keytip="6" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang06" size="large" keytip="7" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang07" size="large" keytip="8" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang08" size="large" keytip="9" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang09" size="large" keytip="0" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang10" size="large" keytip="F" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang11" size="large" keytip="G" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang12" size="large" keytip="K" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <button id="slotLang13" size="large" keytip="N" getVisible="GetSlotVisible" getLabel="GetSlotLabel" getImage="GetSlotImage" getScreentip="GetSlotScreentip" onAction="SlotButtonClicked"/>
                  <dynamicMenu id="menuMoreLanguages"
                               label="More languages..."
                               size="large"
                               keytip="M"
                               image="Other.png"
                               screentip="More languages enabled via Languages... but not pinned to the ribbon"
                               getContent="GetMoreLanguagesMenu"
                               getVisible="GetMoreMenuVisible"/>
				</group>
        <!--
          Hidden catalogue group. LanguageRegistry walks any group whose id starts
          with "groupLanguage" and turns every <button> descendant into a
          LanguageDescriptor, so this group is the canonical 27-language catalogue.
          It is never rendered (visible="false" on the group is schema-valid under
          CustomUI14 and is the standard non-rendering-group mechanism), so its
          buttons are parse-only data: they keep id/tag/label/image/screentip/keytip
          for the registry but carry no onAction, no getVisible and no size.
        -->
        <group id="groupLanguageCatalogue" label="Language Catalogue" visible="false">
                  <button id="buttonCSharp" label="C#" screentip="Enter C# Code" tag="cs" keytip="C" image="cs.png"/>
                  <button id="buttonSQL" label="SQL" screentip="Enter SQL Code" tag="sql" keytip="S" image="sql.png"/>
                  <button id="buttonCSS" label="CSS" screentip="Enter CSS Code" image="css.png" tag="css" keytip="E"/>
                  <button id="buttonJS" label="JS" screentip="Enter JS Code" tag="js" keytip="J" image="js.png"/>
                  <button id="buttonHTML" label="HTML" screentip="Enter HTML Code" tag="html" keytip="H" image="html.png"/>
                  <button id="buttonXML" label="XML" screentip="Enter XML Code" tag="xml" keytip="X" image="xml.png"/>
                  <button id="buttonJAVA" label="JAVA" screentip="Enter JAVA Code" tag="java" keytip="V" image="jar.png"/>
                  <button id="buttonPHP" label="PHP" screentip="Enter PHP Code" tag="php" keytip="P" image="php.png"/>
                  <button id="buttonPerl" label="Perl" screentip="Enter Perl Code" tag="perl" keytip="B" image="pl.png"/>
                  <button id="buttonPython" label="Python" screentip="Enter Python Code" tag="py" keytip="A" image="py.png"/>
                  <button id="buttonRuby" label="Ruby" screentip="Enter Ruby Code" tag="ruby" keytip="R" image="rb.png"/>
                  <button id="buttonCpp" label="CPP" screentip="Enter C++ Code" tag="c" keytip="D" image="c.png"/>
                  <button id="buttonPowerShell" label="PowerShell" screentip="Enter PowerShell Code" tag="ps1" image="ps1.png"/>
                  <button id="buttonDOSBatch" label="DOS Batch" screentip="Enter DOS Batch Code" tag="bat" image="bat.png"/>
                  <button id="buttonJSON" label="JSON" screentip="Enter JSON Code" tag="json" image="json.png"/>
                  <button id="buttonLua" label="Lua" screentip="Enter Lua Code" tag="lua" image="lua.png"/>
                  <button id="buttonMarkdown" label="Markdown" screentip="Enter Markdown Code" tag="md" image="md.png"/>
                  <button id="buttonMSSQL" label="MSSQL" screentip="Enter MSSQL Code" tag="mssql" image="sql.png"/>
                  <button id="buttonObjectiveC" label="Objective C" screentip="Enter Objective C Code" tag="objc" image="m.png"/>
                  <button id="buttonBash" label="Bash" screentip="Enter Bash Code" tag="sh" image="sh.png"/>
                  <button id="buttonVisualBasic" label="Visual Basic" screentip="Enter Visual Basic Code" tag="vb" image="vbs.png"/>
                  <button id="buttonTypeScript" label="TypeScript" screentip="Enter Type Script Code" tag="ts" image="ts.png"/>
                  <button id="buttonAutoHotkey" label="AutoHotkey" screentip="Enter AutoHotkey Code" tag="autohotkey" image="ahk.png"/>
                  <button id="buttonDockerfile" label="Dockerfile" screentip="Enter Dockerfile Code" tag="dockerfile" image="dockerfile.png"/>
                  <button id="buttonKotlin" label="Kotlin" screentip="Enter Kotlin Code" tag="kotlin" image="kt.png"/>
                  <button id="buttonLaTeX" label="LaTeX" screentip="Enter LaTeX Code" tag="tex" image="tex.png"/>
                  <button id="buttonRust" label="Rust" screentip="Enter Rust Code" tag="rust" image="rs.png"/>
                  <button id="buttonYAML" label="YAML" screentip="Enter YAML Code" tag="yaml" image="yml.png"/>
        </group>
        <group label="Advanced" id="Advanced">
                <checkBox id="cbQuickStyle"  label="Quick Style" onAction="cbQuickStyle_OnAction" getPressed="cbQuickStyle_GetPressed"/>
                <button id="buttonSettings" label="Settings" size="normal" screentip="Advanced settings" onAction="SettingsButtonClicked" image="Other.png" visible="true"/>
                <button id="buttonLanguages" label="Languages..." size="normal" keytip="L" screentip="Choose which languages appear on the ribbon" onAction="LanguagesButtonClicked" image="Other.png"/>
        </group>
            </tab>
        </tabs>
    </ribbon>
</customUI>

